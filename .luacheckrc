-- Every WoW global the addon reads is declared here, so real problems stand out.

local wow_api = {
    -- EllesmereUI and Baganator public surfaces
    "Baganator",
    "EllesmereUI",

    -- Frames
    "CharacterFrame",
    "CreateFrame",
    "GameTooltip",
    "GroupFinderFrame",
    "InspectFrame",
    "LFGListFrame",
    "PVPQueueFrame",
    "UIParent",

    -- Chat
    "C_ChatBubbles",
    "CHAT_FRAMES",
    "ChatFrame_AddMessageEventFilter",
    "DEFAULT_CHAT_FRAME",
    "FCF_OpenNewWindow",
    "FCF_OpenTemporaryWindow",

    -- Items
    "C_Item",
    "Enum",
    "GetInventoryItemLink",
    "GetItemInfoInstant",
    "INVSLOT_BACK",
    "INVSLOT_CHEST",
    "INVSLOT_FEET",
    "INVSLOT_FINGER1",
    "INVSLOT_FINGER2",
    "INVSLOT_HEAD",
    "INVSLOT_LEGS",
    "INVSLOT_MAINHAND",
    "INVSLOT_OFFHAND",
    "INVSLOT_SHOULDER",
    "INVSLOT_WRIST",

    -- Units
    "InCombatLockdown",
    "UnitExists",
    "UnitLevel",

    -- Misc
    "C_AddOns",
    "C_Timer",
    "GetTime",
    "geterrorhandler",
    "hooksecurefunc",
    "issecretvalue",
    "strmatch",
}

std = "lua51"
max_line_length = 120
codes = true
exclude_files = { ".release/" }

globals = {
    "SimpleEllesmereExtrasDB", -- SavedVariables
    "SlashCmdList",
    "SLASH_EUIEMOJI1",
    "SLASH_EUIHOVER1",
    "SLASH_SEEDIAG1",
    "SLASH_EUILOCAL1",
    "SLASH_EUIDIAG1",
    "EllesmereUIDB",
}

read_globals = wow_api

-- Emoji.lua's alias and art tables are generated by tools/make-emoji.py.
files["Emoji.lua"] = {
    ignore = { "631" }, -- long lines in the generated block
}

-- The stubs define the client API, so there it is writable.
files["tests/"] = {
    globals = wow_api,
    ignore = {
        "212", -- stub signatures mirror Blizzard's, unused args and all
        "121/print", -- replaced to capture the addon's output
        "411", -- fixtures reuse short names across independent blocks
        "431",
        "631",
    },
}
